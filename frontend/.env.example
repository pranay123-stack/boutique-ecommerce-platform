# Browser-visible. The API is reached through the Next rewrite at /api/proxy so
# authentication cookies remain first-party.
NEXT_PUBLIC_API_URL=/api/proxy
NEXT_PUBLIC_API_ORIGIN=http://localhost:4100
NEXT_PUBLIC_SITE_NAME=Boutique
NEXT_PUBLIC_CURRENCY=INR
# Server-side only: used by React Server Components fetching directly.
API_ORIGIN=http://localhost:4100

# ---------------------------------------------------------------------------
# Business identity shown on the legal pages
#
# REQUIRED before publishing. Until these are set, the policy pages display a
# banner saying they are not ready - deliberately, because a polished policy
# page with invented company details is worse than an obviously unfinished one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_CIN=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# Required by the IT Act, 2000 and the rules under it.
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_JURISDICTION=Bengaluru, Karnataka
# Date the policy text was last reviewed, not the last deploy.
NEXT_PUBLIC_POLICY_UPDATED=2026-08-17

# Keep these in step with the backend, or the policy pages will promise
# something the API does not do.
NEXT_PUBLIC_RETURN_WINDOW_DAYS=7
NEXT_PUBLIC_EXCHANGE_WINDOW_DAYS=14
NEXT_PUBLIC_REFUND_BUSINESS_DAYS=7
NEXT_PUBLIC_DISPATCH_BUSINESS_DAYS=2
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1999
NEXT_PUBLIC_FLAT_SHIPPING_RATE=99
NEXT_PUBLIC_COD_CHARGE=49

# Set to false on staging and preview deployments so they are never indexed.
NEXT_PUBLIC_ALLOW_INDEXING=true
