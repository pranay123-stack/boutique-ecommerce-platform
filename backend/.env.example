# ===========================================================================
# Boutique Commerce - environment template
#
#   cp .env.example .env      then fill in the values below.
#
# Generate strong secrets with:
#   openssl rand -hex 48
#
# Never commit a real .env. The API refuses to boot in production if secrets
# are missing, too short, identical, or look like placeholders.
# ===========================================================================

# ------------------------------- RUNTIME ----------------------------------
NODE_ENV=development                  # development | test | staging | production
PORT=4100
API_PREFIX=api/v1
APP_NAME="Boutique Commerce"
FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:4100
# Comma-separated. MUST be set explicitly in production - no wildcards.
CORS_ORIGINS=http://localhost:3100

# ------------------------------- DATABASE ---------------------------------
# connection_limit should be (max_connections / number of app instances) - headroom.
DATABASE_URL="postgresql://boutique:boutique_dev_pw@localhost:5470/boutique_dev?schema=public&connection_limit=20&pool_timeout=20"

# --------------------------------- REDIS ----------------------------------
# Cache + BullMQ queues. The app degrades to direct DB reads if Redis is down.
REDIS_HOST=localhost
REDIS_PORT=6399
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
CACHE_TTL_SECONDS=300

# ---------------------------------- AUTH ----------------------------------
# Access token is a short-lived JWT; the refresh token is an opaque, rotating,
# httpOnly cookie stored only as a SHA-256 hash.
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-openssl-rand-hex-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace-with-openssl-rand-hex-32
CSRF_SECRET=replace-with-openssl-rand-hex-32
BCRYPT_ROUNDS=12                      # >=12 in production

# ------------------------------ RATE LIMITS -------------------------------
# One global baseline. Auth routes tighten it per-handler (3-10/min).
# Do NOT add a second named throttler: every throttler applies to every route.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=600
THROTTLE_AUTH_LIMIT=10

# -------------------------------- PAYMENTS --------------------------------
# PAYMENT_MODE=mock runs an offline gateway that still signs and verifies real
# HMACs. It is rejected at boot when NODE_ENV=production.
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=mock                     # mock | live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Future providers - the adapter interface is already in place.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------------------------- SHIPPING --------------------------------
SHIPPING_PROVIDER=shiprocket
SHIPPING_MODE=mock                    # mock | live
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
SHIPPING_PICKUP_POSTCODE=560001
SHIPPING_FREE_THRESHOLD=1999
SHIPPING_FLAT_RATE=99

# ----------------------------- NOTIFICATIONS ------------------------------
NOTIFICATIONS_MODE=mock               # mock | live
MAIL_FROM="Boutique Commerce <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025                        # MailHog in docker-compose.dev.yml
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=mock
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=

# --------------------------------- STORAGE --------------------------------
STORAGE_DRIVER=local                  # local | s3 | cloudinary
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4100/static
MAX_UPLOAD_SIZE_MB=5
# S3-compatible: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
CLOUDINARY_URL=

# ------------------------------ OBSERVABILITY -----------------------------
LOG_LEVEL=debug                       # trace|debug|info|warn|error|silent
LOG_PRETTY=true                       # false in production (JSON logs)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boutique-api

# ---------------------------------- SEED ----------------------------------
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@boutique.local
SEED_CUSTOMER_PASSWORD=Customer@12345

# ------------------------- DOCKER COMPOSE ONLY ----------------------------
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique_dev_pw
POSTGRES_DB=boutique_dev
POSTGRES_PORT=5470
REDIS_PORT=6399
BACKEND_PORT=4100
FRONTEND_PORT=3100

# ----------------------------- FRONTEND (build) ---------------------------
NEXT_PUBLIC_API_URL=/api/proxy
NEXT_PUBLIC_API_ORIGIN=http://localhost:4100
NEXT_PUBLIC_SITE_NAME=Boutique
NEXT_PUBLIC_CURRENCY=INR

# ---------------------------------------------------------------------------
# GST and invoicing (India)
#
# REQUIRED before taking live orders. A tax invoice without the seller's real
# GSTIN, legal name and registered address is defective, and an incorrect
# SELLER_STATE makes every invoice charge the wrong heads of tax (CGST+SGST
# where IGST was due, or the reverse).
# ---------------------------------------------------------------------------
# Indian retail quotes GST-inclusive prices: an item advertised at 2,450 is
# charged at 2,450, with the tax backed out of that figure. Set false only for
# a market that quotes ex-tax.
TAX_PRICES_INCLUDE_GST=true
# Round the payable to the nearest rupee and state the adjustment on the invoice.
TAX_ROUND_OFF_TOTAL=true
SELLER_GSTIN=
SELLER_LEGAL_NAME=
SELLER_TRADE_NAME=
SELLER_ADDRESS=
# Decides intra-state (CGST+SGST) vs inter-state (IGST). Spell it as in the
# GST state list, e.g. "Karnataka", "Tamil Nadu", "Delhi".
SELLER_STATE=Karnataka
SELLER_PAN=
# Invoice numbers are gapless and restart each financial year: INV/2026-27/00001
INVOICE_PREFIX=INV

# ---------------------------------------------------------------------------
# Cash on delivery
# ---------------------------------------------------------------------------
COD_ENABLED=true
# Handling charge added to a COD order, GST-inclusive.
COD_CHARGE=49
COD_MIN_ORDER=0
# Ceiling on the cash a courier will carry, and on what a refused delivery costs.
COD_MAX_ORDER=20000
# Comma-separated pincode prefixes where COD is refused, used when the shipping
# provider is in mock mode.
COD_BLOCKED_PIN_PREFIXES=

# ---------------------------------------------------------------------------
# Returns
# ---------------------------------------------------------------------------
# Days after delivery in which a customer may open a return. Keep in step with
# NEXT_PUBLIC_RETURN_WINDOW_DAYS on the frontend and the returns policy page.
RETURN_WINDOW_DAYS=7
EXCHANGE_WINDOW_DAYS=14

# ---------------------------------------------------------------------------
# Support
# ---------------------------------------------------------------------------
# Where contact-form messages are emailed. Blank stores them for the admin only.
SUPPORT_INBOX=

# ---------------------------------------------------------------------------
# Demo product imagery (seed only)
#
# generated (default) | picsum | pexels | unsplash
# Pexels issues a key instantly; Unsplash reviews applications for 5-10 days.
# Both require photographer attribution, which the seed records in
# uploads/image-credits.json and the storefront renders. Delete both the key
# and the sidecar once real product photography replaces the placeholders.
# ---------------------------------------------------------------------------
SEED_IMAGE_SOURCE=generated
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
