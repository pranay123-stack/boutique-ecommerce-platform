{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Incremental builds are disabled here on purpose: nest-cli wipes outDir
    // before compiling, so a stale .tsbuildinfo makes tsc skip emitting files
    // that no longer exist on disk.
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
