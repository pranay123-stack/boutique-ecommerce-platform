# ===========================================================================
# Boutique Commerce - environment template
#
#   cp .env.example .env      then fill in the values below.
#
# Generate strong secrets with:
#   openssl rand -hex 48
#
# Never commit a real .env. The API refuses to boot in production if secrets
# are missing, too short, identical, or look like placeholders.
# ===========================================================================

# ------------------------------- RUNTIME ----------------------------------
NODE_ENV=development                  # development | test | staging | production
PORT=4100
API_PREFIX=api/v1
APP_NAME="Boutique Commerce"
FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:4100
# Comma-separated. MUST be set explicitly in production - no wildcards.
CORS_ORIGINS=http://localhost:3100

# ------------------------------- DATABASE ---------------------------------
# connection_limit should be (max_connections / number of app instances) - headroom.
DATABASE_URL="postgresql://boutique:boutique_dev_pw@localhost:5470/boutique_dev?schema=public&connection_limit=20&pool_timeout=20"

# --------------------------------- REDIS ----------------------------------
# Cache + BullMQ queues. The app degrades to direct DB reads if Redis is down.
REDIS_HOST=localhost
REDIS_PORT=6399
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
CACHE_TTL_SECONDS=300

# ---------------------------------- AUTH ----------------------------------
# Access token is a short-lived JWT; the refresh token is an opaque, rotating,
# httpOnly cookie stored only as a SHA-256 hash.
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-openssl-rand-hex-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace-with-openssl-rand-hex-32
CSRF_SECRET=replace-with-openssl-rand-hex-32
BCRYPT_ROUNDS=12                      # >=12 in production

# ------------------------------ RATE LIMITS -------------------------------
# One global baseline. Auth routes tighten it per-handler (3-10/min).
# Do NOT add a second named throttler: every throttler applies to every route.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=600
# Proxy hops to trust for client-IP resolution (0 = direct, 1 = one nginx/ALB).
# MUST be >0 behind a load balancer, or the entire site shares one rate limit.
TRUST_PROXY=0
# Share rate-limit counters across instances via Redis. In-memory counters are
# per-process, so N instances would silently allow N x the intended limit.
THROTTLE_USE_REDIS=true
THROTTLE_AUTH_LIMIT=10
# Multiplies the strict per-route auth limits above. Intended for end-to-end
# harnesses that sign in repeatedly from a single IP. Leave unset in production.
AUTH_THROTTLE_MULTIPLIER=1

# -------------------------------- PAYMENTS --------------------------------
# PAYMENT_MODE=mock runs an offline gateway that still signs and verifies real
# HMACs. It is rejected at boot when NODE_ENV=production.
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=mock                     # mock | live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Future providers - the adapter interface is already in place.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------------------------- SHIPPING --------------------------------
SHIPPING_PROVIDER=shiprocket
SHIPPING_MODE=mock                    # mock | live
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
SHIPPING_PICKUP_POSTCODE=560001
SHIPPING_FREE_THRESHOLD=1999
SHIPPING_FLAT_RATE=99

# ----------------------------- NOTIFICATIONS ------------------------------
NOTIFICATIONS_MODE=mock               # mock | live
MAIL_FROM="Boutique Commerce <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025                        # MailHog in docker-compose.dev.yml
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMS: mock | twilio | msg91
SMS_PROVIDER=mock
SMS_API_KEY=                          # Twilio auth token, or MSG91 authkey
SMS_SENDER_ID=BOUTIQ                  # Twilio: the From number; MSG91: sender id
SMS_ACCOUNT_SID=                      # Twilio only
# WhatsApp: mock | meta (Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=                     # permanent access token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=               # required outside the 24h service window
WHATSAPP_TEMPLATE_LANG=en

# --------------------------------- STORAGE --------------------------------
# Seed imagery: generated (SVG silhouettes, offline) | picsum (real photos,
# random subjects, no key) | unsplash (real, keyword-matched, needs a free key).
SEED_IMAGE_SOURCE=generated
UNSPLASH_ACCESS_KEY=

STORAGE_DRIVER=local                  # local | s3 | cloudinary
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=/static
MAX_UPLOAD_SIZE_MB=5
# S3-compatible: AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
CLOUDINARY_URL=

# ------------------------------ OBSERVABILITY -----------------------------
LOG_LEVEL=debug                       # trace|debug|info|warn|error|silent
LOG_PRETTY=true                       # false in production (JSON logs)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boutique-api

# ---------------------------------- SEED ----------------------------------
SEED_ADMIN_EMAIL=admin@boutique.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=customer@boutique.local
SEED_CUSTOMER_PASSWORD=Customer@12345

# ------------------------- DOCKER COMPOSE ONLY ----------------------------
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique_dev_pw
POSTGRES_DB=boutique_dev
POSTGRES_PORT=5470
REDIS_PORT=6399
BACKEND_PORT=4100
FRONTEND_PORT=3100

# ----------------------------- FRONTEND (build) ---------------------------
NEXT_PUBLIC_API_URL=/api/proxy
NEXT_PUBLIC_API_ORIGIN=http://localhost:4100
NEXT_PUBLIC_SITE_NAME=Boutique
NEXT_PUBLIC_CURRENCY=INR
